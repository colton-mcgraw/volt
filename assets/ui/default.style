{
    "name": "default.style",
    "version": "1.0.0",
    "description": "Default UI style for Volt Engine",
    "author": "Colton McGraw",
    {
        "primaryColor": "#3498db",
        "secondaryColor": "#2ecc71",
        "backgroundColor": "#ecf0f1",
        "textColor": "#2c3e50",
        "fontFamily": "Arial, sans-serif",
        "fontSize": "14px",
        "borderRadius": "4px",
        "padding": "10px"
    },
    {
        "button": {
            "backgroundColor": "#3498db",
            "color": "#ffffff",
            "border": "none",
            "hoverBackgroundColor": "#2980b9"
        },
        "input": {
            "backgroundColor": "#ecf0f1",
            "color": "#2c3e50",
            "border": "1px solid #bdc3c7",
            "focusBorderColor": "#3498db"
        },
        "modal": {
            "backgroundColor": "#ffffff",
            "color": "#2c3e50",
            "border": "1px solid #bdc3c7",
            "overlayBackgroundColor": "rgba(0, 0, 0, 0.5)"
        }
    }
}